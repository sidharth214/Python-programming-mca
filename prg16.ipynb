   "source": [
    "try:\n",
    "    age = int(input(\"Enter your age: \"))\n",
    "\n",
    "    if age <= 0:\n",
    "        raise ValueError(\"Invalid input! Age must be a positive number.\")\n",
    "\n",
    "    print(\"Your age is:\", age)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(\"Error:\", e)\n"
   ]
